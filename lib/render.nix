{ host, lib }:

let
  defaultFontFamily = "JetBrainsMono Nerd Font";

  # Repo-local VM MCP server. The VM is specific to this repository (its age
  # key / QEMU lifecycle live in runtime/vm), so agents only get this server
  # when running inside the repo, never from the global home config.
  vmMcp = {
    type = "remote";
    url = "http://localhost:8765/mcp";
  };

  # Repo-root agent configs generated by `angst render`. Paths are relative to
  # the repo root. These are committed so a fresh clone already has the VM MCP.
  # MCP shape follows the OpenCode v2 schema: servers live under `mcp.servers`
  # and `enabled` is gone (v2 uses inverse `disabled`; absent = enabled).
  renderProjectOutputs = [
    {
      path = "opencode.json";
      text =
        builtins.toJSON {
          "$schema" = "https://opencode.ai/config.json";
          mcp = {
            servers = {
              vm = vmMcp;
            };
          };
        }
        + "\n";
    }
  ];
in
rec {
  inherit renderProjectOutputs;

  renderDomainOutputsFor =
    themeName:
    let
      themesLib = host.scan.themes;
      checkHelpers = import ../checks/theme/assertions.nix {
        inherit lib;
        theme = themesLib.get themeName;
        inherit themeName;
      };
      domainRendererPaths = map (e: e.path + "/render.nix") (
        lib.filter (e: e.hasRender or false) host.scan.domains.homeEntries
      );
    in
    lib.concatLists (
      map (
        path:
        let
          render = import path;
        in
        render (
          lib.filterAttrs (name: _: builtins.hasAttr name (lib.functionArgs render)) {
            inherit
              lib
              themesLib
              themeName
              checkHelpers
              host
              ;
            fontFamily = defaultFontFamily;
            monitors = host.monitors or { };
            db = host.db or [ ];
            sshAgent = host.sshAgent or { };
            homeDirectory = "/home/${host.username}";
          }
        )
      ) domainRendererPaths
    );

  renderDomainOutputFor =
    themeName: outputPath:
    let
      matches = lib.filter (output: output.path == outputPath) (renderDomainOutputsFor themeName);
    in
    if matches == [ ] then
      throw "Unknown domain render output: ${outputPath}"
    else
      (builtins.head matches).text;
}
