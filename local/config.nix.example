# local/config.nix.example — machine identity template
#
# Copy to local/config.nix and fill in your values.
# local/ is gitignored — it won't be tracked or overwritten by git pull.
#
# repoPath: relative path from $HOME to this git checkout.
#   The activation scripts resolve config dirs from $HOME/$repoPath.
#   On NixOS this is typically "proj/angst".
#   Verify with: git rev-parse --show-prefix
#
# toolchains: "*" for all, or a list like ["bash" "nix" "php"]
#             for a minimal server setup.
{
  system = "x86_64-linux";
  repoPath = "proj/angst";
  hostname = "nixos";
  username = "joao";
  theme = "miasma";
  profiles = ["base" "desktop" "development"];
  toolchains = "*";

  # Hashed password — NOT plaintext. Generate with: just password
  password = "$6$exampleSalt1234$abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdef";

  monitors = {
    primary = {
      name = "DP-1";
      resolution = "1920x1080";
      refreshRate = 144;
      position = "0x0";
    };
  };

  # Database connections injected into the sql-client domains (rainfrog, sqlit).
  # type: postgres | mysql | sqlite | oracle | mssql | mariadb | duckdb | redshift | cockroachdb
  #   - rainfrog supports: postgres, mysql, sqlite, oracle, duckdb
  #   - sqlit supports:    postgres, mysql, sqlite, oracle, mssql, mariadb, duckdb, redshift, cockroachdb
  # For sqlite, give a filesystem path (absolute or relative); it becomes sqlite://<path> in rainfrog.
  # Passwords are optional; rainfrog stores them in the OS keyring (its config has no password field),
  # while sqlit reads them from the rendered connections.json.
  db = {
    connections = {
      # dev = {
      #   type = "postgres";
      #   host = "localhost";
      #   port = 5432;
      #   database = "app";
      #   username = "app";
      #   password = "secret";
      #   default = true;
      # };
      # app-sqlite = {
      #   type = "sqlite";
      #   path = "/home/joao/proj/app.db";
      # };
    };
  };

  nixos = {
    keyboardLayout = "br-abnt2";  # console keymap + X11 layout ("layout-variant" or just "layout")
  };
  home = {};   # one-off HM config (replaces host-specific home.nix)

  # Environment variables propagated to both home-manager and NixOS
  env = {
    EDITOR = "nvim";
    BROWSER = "firefox";
  };

  # Login shell to sync on non-NixOS hosts (sets /etc/shells + chsh on activation;
  # needs root or sudo). A shell name available in the nix profile or system, e.g.
  # "nu", "zsh", "bash". Validated at build time against the host. NixOS hosts are
  # skipped (login shell managed by NixOS config).
  shell = "nu";

  # SSH keys loaded into a persistent SSH agent at login.
  # A systemd user service runs ssh-agent and a nushell bootstrap loads these
  # keys once per login (GUI passphrase prompt on graphical hosts, tty prompt
  # over SSH). Works on NixOS desktop, headless servers, and home-manager on
  # non-NixOS hosts. If enable is false or none of the keys exist, the agent
  # is not started at all.
  sshAgent = {
    enable = true;
    keys = [
      "~/.ssh/id_ed25519"
      # "~/.ssh/id_rsa"
      # "~/.ssh/github"
    ];
  };

  # Per-host SSH client entries written to ~/.ssh/config.d/angst.conf
  # (the module appends an `Include` line to ~/.ssh/config on activation).
  # Use for hosts whose keys have non-default names — e.g. a dedicated key
  # for a GitLab instance:
  # ssh = {
  #   hosts = [{
  #     host = "gitlab.ezvoice.com.br";
  #     hostName = "gitlab.ezvoice.com.br";
  #     user = "git";
  #     identityFile = "~/.ssh/work_key";
  #     identitiesOnly = true;
  #   }];
  # };
}
